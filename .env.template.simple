# Essential environment variables for quick setup

# API Key for the LLM provider (either OpenAI, Together AI or Google)
LLM_API_KEY=
# Choose your LLM provider: together / openai / ollama / google
LLM_PROVIDER=
# Primary model; blank uses the YAML default (zai-org/GLM-5.3-Flash).
LLM_MODEL_NAME=

# Together only: up to four ordered fallback models, as a JSON array.
# Omit to use app/assets/config/base.yml; [] disables fallback models.
# LLM_FALLBACK_MODELS=["deepseek-ai/DeepSeek-V4.1-Flash"]
# Per-attempt cap, total time budget per LLM request, and failure cooldown (seconds).
# LLM_FAILOVER_ATTEMPT_TIMEOUT=60
# LLM_FAILOVER_TOTAL_TIMEOUT=180
# LLM_FAILOVER_COOLDOWN_SECONDS=60

# API Key for the Embedding provider (either OpenAI or Together AI)
EMBEDDING_API_KEY=
# Choose your Embedding provider: google / together / openai / ollama
EMBEDDING_PROVIDER=
# For Google Vertex AI, set provider=google and model=gemini-embedding-001.
# ADC authentication; EMBEDDING_API_KEY is not used for Google.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Postgres database URL
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_URL=postgresql://postgres:mysecurepassword@127.0.0.1:5432/twiga_db


# App configuration
ENVIRONMENT="local"
DEBUG=True
MOCK_WHATSAPP=True
MOCK_WHATSAPP_API_URL=http://127.0.0.1:3000/api/whatsapp
MOCK_WHATSAPP_TOKEN=change-me-local-token
BUSINESS_ENV=False
EXAM_GENERATION_LIMIT=5
EXAM_GENERATION_WINDOW_DAYS=7

# Meta API credentials
META_API_VERSION="v22.0"
META_APP_ID="placeholder"
META_APP_SECRET="placeholder"
WHATSAPP_CLOUD_NUMBER_ID="placeholder"
WHATSAPP_VERIFY_TOKEN="placeholder"
WHATSAPP_API_TOKEN="placeholder"
